{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "mcp": {
    "gcp-maestro": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "agents/maestro_mcp_server.py"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "governance-rag": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "mcp/11_mcp_rag_server.py"
      ],
      "enabled": true,
      "timeout": 120000
    },
    
    
    "google-drive": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "mcp/15_a_mcp_srvr_drive.py"
      ],
      "enabled": true,
      "timeout": 120000
    },
    
    "banking-audit": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/oscar/tec_agentic_ai",
        "python",
        "mcp/18_banking_audit.py"
      ],
      "enabled": true
    }

  }
}



